APP_ENV=development
FRONTEND_PORT=13110
BACKEND_PORT=18080
HOST_BACKEND_PORT=18190
AGENT_WORKER_PORT=18090
POSTGRES_PORT=25440
REDIS_PORT=16400
MINIO_PORT=19110
MINIO_CONSOLE_PORT=19111

DATABASE_DSN=host=postgres user=shenji password=shenji dbname=shenji port=5432 sslmode=disable TimeZone=UTC
REDIS_ADDR=redis:6379
WORKSPACE_ROOT=/app/workspace
HOST_WORKSPACE_ROOT=/Users/rabbit/Desktop/shenji/workspace
ARTIFACT_ROOT=/app/workspace/artifacts
ARTIFACT_STORE_TYPE=minio
RUNNER_IMAGES_ROOT=/app/runner-images
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rabbit-artifacts
MINIO_USE_SSL=false
PENTEST_RUNNER_IMAGE=rabbit-runner-pentest:local
PI_WORKER_IMAGE=rabbit-pi-worker-kali:local
PI_WORKER_NETWORK_MODE=bridge
SANDBOX_RUNNER_IMAGE=rabbit-runner-sandbox:local
PUBLIC_BASE_URL=http://localhost:18190
CORS_ORIGINS=http://localhost:13110,http://127.0.0.1:13110

MODEL_TIMEOUT_SECONDS=90
TOOL_TIMEOUT_SECONDS=180
SANDBOX_TIMEOUT_SECONDS=300
WORKER_LEASE_TIMEOUT_SECONDS=120
MAX_ITERATIONS=30
MAX_RUNTIME_MINUTES=60
MAX_TOOL_RUNS=120
MAX_PENDING_INTENTS=40

POSTGRES_IMAGE=docker.io/library/postgres:16-alpine
REDIS_IMAGE=docker.io/library/redis:7-alpine
MINIO_IMAGE=docker.io/minio/minio:RELEASE.2025-01-20T14-49-07Z
GO_BASE_IMAGE=docker.io/library/golang:1.25-alpine
ALPINE_BASE_IMAGE=docker.io/library/alpine:3.21
NODE_BASE_IMAGE=docker.io/library/node:25-alpine
NGINX_BASE_IMAGE=docker.io/library/nginx:1.27-alpine

OPENAI_API_KEY=
JWT_SECRET=rabbit-shenji-change-this-in-production
